uniform highp float intensity;
uniform highp float time_created;
uniform highp vec3 color;
uniform lowp float color_darkness;

highp float hash(highp vec2 p){
  p = fract(p * vec2(127.1, 311.7));
  p += dot(p, p + 19.19);
  return fract(p.x * p.y);
}

highp float noise(highp vec2 p){
  highp vec2 i = floor(p);
  highp vec2 f = fract(p);
  highp vec2 u = f*f*(3.0-2.0*f);
  return mix(
    mix(hash(i),           hash(i+vec2(1,0)), u.x),
    mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x),
    u.y
  );
}

void fragment() {
  highp vec4 base = zTexture(UV);
  highp float coverage = clamp(intensity, 0.0, 1.0);
  highp vec2 uv = UV2;
  highp vec2 pixelUv = floor(uv * 32.0) / 32.0;

  highp float largeNoise = noise(pixelUv * 5.0);
  highp float detailNoise = noise(pixelUv * 11.0 + vec2(13.7, 4.1));
  highp float maskNoise = largeNoise * 0.75 + detailNoise * 0.25;

  highp float threshold = mix(1.1, -0.1, coverage);
  highp float edgeWidth = max(fwidth(maskNoise) * 2.0, 0.02);
  highp float splatterMask = smoothstep(threshold - edgeWidth, threshold + edgeWidth, maskNoise);

  highp float alphaNoise = noise(pixelUv * 8.0 + vec2(21.3, 6.8));
  highp float overlayAlpha = splatterMask * mix(0.3, 0.9, alphaNoise);

  COLOR = vec4(mix(base.rgb, color - color_darkness, overlayAlpha), base.a);
}
