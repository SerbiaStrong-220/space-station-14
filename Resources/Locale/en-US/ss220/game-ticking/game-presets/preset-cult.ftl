cult-yogg-title = Cult of Yog-Sothoth
cult-yogg-description = A hostile cult has been active aboard the station.
cult-yogg-not-enough-ready-players = Not enough players are ready! Ready: { $readyPlayersCount }, required: { $minimumPlayers }. Cannot start Cult mode.
cult-yogg-no-one-ready = No players are ready! Cannot start Cult mode.
cult-yogg-role-greeting =
    The time has come! You have been chosen, granted forbidden knowledge, and sent here to ascend and summon our teacher, [color=darkgreen]Nyarlathotep[/color]!
    Find your brethren, raise one of your number to a higher form, expand the cult, and establish a lair where sacrifices will be offered to our god, [color=peru]Yog-Sothoth[/color]!
    Ia c-chtenff!

cult-yogg-round-end-initial-count = Initial cultists: { $initialCount }. They were:
cult-yogg-round-end-user-was-initial = - [color=plum]{ $name }[/color] ([color=gray]{ $username }[/color]) — an original follower.
cult-yogg-round-end-enslaved-count = Converted cultists: { $initialCount }. They were:
cult-yogg-round-end-user-was-enslaved = - [color=plum]{ $name }[/color] ([color=gray]{ $username }[/color]) — a converted follower.

cult-yogg-round-end-amount-none = [color=green]All followers of the cult were eliminated![/color]
cult-yogg-round-end-amount-low = [color=green]Almost all followers of the cult were eliminated.[/color]
cult-yogg-round-end-amount-medium = [color=yellow]The cult failed to perform the summoning.[/color]
cult-yogg-round-end-amount-high = [color=crimson]The cult came close to completing the summoning.[/color]
cult-yogg-round-end-win = [color=darkred]The Master has entered our world![/color]

cult-yogg-add-token-no-cultists = Not a single follower remains in the cult. Any Mi-Go can convert a new follower without mi-gomycelium.

cult-yogg-cultists-warning = Attention! Widespread growth of parasitic fungi has been detected aboard the station. Sensor readings confirm a cult threat. Eliminate it at any cost!
cult-yogg-shuttle-call = Station sensors have detected a gigantic moving object { $location }. The emergency shuttle has been dispatched to evacuate the remaining personnel.

cult-yogg-reveal-telepathy-announce = The light of Yog-Sothoth's knowledge now dwells in your gaze.
cult-yogg-alarm-telepathy-announce = Our followers have reached critical mass. The unbelievers will soon discover our presence.

cult-yogg-cultists-numb-info =
    Cultists: { $cultists } (alive: { $aliveCultists })
    Mi-Go: { $MiGo } (alive: { $aliveMiGo })

cult-yogg-stage-info =
    Current cult stage: { cult-yogg-stage-name }
    Cult members required to reach the next stage: { $count }

cult-yogg-sacrifice-only-stage-alarm = Sacrifices can only be performed after completing the recruitment objective.
cult-yogg-sacrifice-warning = A sacrifice is being performed { $location }, at coordinates { $coords }, that could open a rift into another reality. Stop the ritual at any cost!
