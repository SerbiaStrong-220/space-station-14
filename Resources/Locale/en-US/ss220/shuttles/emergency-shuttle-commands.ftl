# Command descriptions and help
cmd-emergency-shuttle-pause-desc = Pauses automatic emergency shuttle departure.
cmd-emergency-shuttle-pause-help = Usage: emergencyshuttlepause
cmd-emergency-shuttle-resume-desc = Resumes the emergency shuttle departure countdown.
cmd-emergency-shuttle-resume-help = Usage: emergencyshuttleresume

# Command results
emergency-shuttle-command-pause-success = Emergency shuttle departure paused.
emergency-shuttle-command-pause-failed = Cannot pause: the shuttle is not docked, is already departing, or is already paused.
emergency-shuttle-command-resume-success = Departure countdown resumed. { $seconds } seconds until departure.
emergency-shuttle-command-resume-failed = Emergency shuttle departure is not paused.
emergency-shuttle-command-resume-hold-remains = Administrative hold removed, but other holds still prevent departure.
