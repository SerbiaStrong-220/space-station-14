<BoxContainer
    Visible="False"
    HorizontalExpand="True"
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <ui:ShuttleNavControl
        Name="NavRadar"
        MouseFilter="Stop"
        VerticalAlignment="Stretch"
        VerticalExpand="True"
        HorizontalExpand="True"
        Margin="5 4 10 5"/>
    <!-- Nav controls -->
    <BoxContainer
        Name="RightDisplayNav"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        VerticalExpand="True"
        MinWidth="256"
        MaxWidth="256"
        Margin="5 0 5 5"
        Orientation="Vertical">
        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavDisplayLabel"
                Text="{Loc 'shuttle-console-display-label'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <GridContainer
            Columns="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalExpand="True"
            Margin="3"
            Name="ReadonlyDisplay">
            <Label Text="{Loc 'shuttle-console-position'}" />
            <Label Name="GridPosition" Text="0.0, 0.0" HorizontalExpand="True" Align="Right" />
            <Label Text="{Loc 'shuttle-console-orientation'}" />
            <Label Name="GridOrientation" Text="0.0" HorizontalExpand="True" Align="Right" />
            <Label Text="{Loc 'shuttle-console-linear-velocity'}" />
            <Label Name="GridLinearVelocity" Text="0.0, 0.0" HorizontalExpand="True" Align="Right" />
            <Label Text="{Loc 'shuttle-console-angular-velocity'}" />
            <Label Name="GridAngularVelocity" Text="0.0" HorizontalExpand="True" Align="Right" />
        </GridContainer>
        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavSettingsLabel"
                Text="{Loc 'shuttle-console-nav-settings'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <Button
            Name="IFFToggle"
            Text="{Loc 'shuttle-console-iff-toggle'}"
            TextAlign="Center"
            ToggleMode="True"/>
        <Button
            Name="DockToggle"
            Text="{Loc 'shuttle-console-dock-toggle'}"
            TextAlign="Center"
            ToggleMode="True"/>
        <!-- SS220 add additional control for shuttle start -->
            <BoxContainer Orientation="Vertical" Name="AdditionalSettingsContainer" Visible="False">
                <controls1:StripeBack Name="SettingsHeader" MinSize="48 48">
                    <controls:Label Name="AdditionalShuttleControlLabel" Text="{controls:Loc 'shuttle-console-additional-settings'}"
                                    VerticalExpand="True"
                                    HorizontalAlignment="Center"/>
                </controls1:StripeBack>
                <BoxContainer Name="AdditionalShuttleControlContainer" Orientation="Vertical">
                    <BoxContainer Orientation="Vertical" Name="RotateToPointToggleContainer">
                        <controls:Button Name="RotateToPointToggle"
                                         Text="{controls:Loc 'shuttle-console-additional-settings-rotate-to-point'}"
                                         TextAlign="Center"
                                         ToggleMode="True"
                                         Access="Public"
                                         SetWidth="346"/>
                        <controls:Button Name="RotateToPointResetButton"
                                         Text="{controls:Loc 'shuttle-console-additional-settings-rotate-to-point-reset'}"
                                         TextAlign="Center"
                                         Access="Public"
                                         SetWidth="346"/>
                        <shuttleGunControl:ShuttleGunControlRotateToPoint
                            Name="RotateToPointFireButton"
                            HorizontalAlignment="Center"
                            Visible="False"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <!-- SS220 add additional control for shuttle end -->
    </BoxContainer>
</BoxContainer>
