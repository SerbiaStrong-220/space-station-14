<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ss220-tts="clr-namespace:Content.Client.SS220.TTS.UI"
    MinSize="200 200">
    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="PromptLabel" Align="Center" HorizontalExpand="True"/>
        <Label Name="DescriptionLabel" Align="Center" FontColorOverride="Gray" HorizontalExpand="True"/>
        <ss220-tts:TtsVoicePreferencesTable Name="TtsVoicePreferencesTable" HorizontalExpand="True" Margin="0 10"/>
        <Button Name="OkButton"
                Text="{Loc 'quick-dialog-ui-confirm'}"
                StyleClasses="OpenBoth"
                MaxWidth="120"
                HorizontalAlignment="Center"
                VerticalExpand="False"
                HorizontalExpand="False">
        </Button>
    </BoxContainer>
</controls:FancyWindow>
