<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:ui="clr-namespace:Content.Client.SS220.CultYogg.CultMiniMap"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc cult-mini-map-title}"
                      Resizable="True"
                      SetSize="1000 640"
                      MinSize="800 480">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" Margin="5 10">
                <ui:CultMiniMapNavMapControl Name="NavMap" HorizontalExpand="True" VerticalExpand="True"/>
                <Label Name="NoMapLabel" Text="{Loc cult-mini-map-no-grid}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visible="False"/>
            </PanelContainer>
            <BoxContainer Orientation="Vertical" SetWidth="420" Margin="5 10">
                <Label Name="StationName" Text="{Loc cult-mini-map-no-grid}" ClipText="True"/>
                <Label Name="MemberCount"/>
                <LineEdit Name="SearchLineEdit" HorizontalExpand="True"
                          PlaceHolder="{Loc cult-mini-map-search}"/>
                <Button Name="PingButton" Text="{Loc cult-mini-map-ping-button}"
                        HorizontalExpand="True" Margin="0 5 0 0"/>
                <ScrollContainer VerticalExpand="True" Margin="0 8">
                    <BoxContainer Name="MembersTable" Orientation="Vertical" HorizontalExpand="True"/>
                </ScrollContainer>
                <Label Name="EmptyLabel" Text="{Loc cult-mini-map-empty}" Visible="False"/>
            </BoxContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider"/>
        <Label Text="{Loc cult-mini-map-legend}" Margin="10 5"/>
    </BoxContainer>
</controls:FancyWindow>
