<messenger:MessengerUiChatItem
    xmlns:messenger="clr-namespace:Content.Client.SS220.Cartridges.Messenger"
    xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"></PanelContainer>
    <PanelContainer Margin="2 3 2 3" StyleClasses="Inset" HorizontalExpand="True">
        <Button Name="OpenChatHistoryButton" Access="Public" HorizontalExpand="True" Mode="Press">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4 2 4 2">
                <Label Name="StatusDot" Text="●" VerticalAlignment="Center" Margin="0 0 8 0"/>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="ChatName" Access="Public" HorizontalExpand="True" ClipText="True"/>
                        <Label Name="StatusLabel" Access="Public" Visible="False" Margin="6 0 0 0"/>
                    </BoxContainer>
                    <RichTextLabel Name="LastMessage" Access="Public" HorizontalAlignment="Left" MaxWidth="240"/>
                </BoxContainer>
                <PanelContainer Name="UnreadBadge" Visible="False" VerticalAlignment="Center" Margin="6 0 0 0">
                    <Label Name="UnreadLabel" Margin="6 0 6 0"/>
                </PanelContainer>
            </BoxContainer>
        </Button>
    </PanelContainer>
</messenger:MessengerUiChatItem>
