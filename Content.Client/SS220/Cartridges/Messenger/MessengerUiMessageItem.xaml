<messenger:MessengerUiMessageItem
    xmlns:messenger="clr-namespace:Content.Client.SS220.Cartridges.Messenger"
    xmlns="https://spacestation14.io"
    Margin="1 0 2 0">
    <PanelContainer Name="MessageContainer" Access="Public" Margin="4 3 4 3" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8 4 8 3">
            <Label Name="SenderLabel" Access="Public" Visible="False" HorizontalAlignment="Left"/>
            <PanelContainer Name="QuotePanel" Visible="False" Margin="0 2 0 3" HorizontalAlignment="Left">
                <BoxContainer Orientation="Vertical" Margin="6 2 6 2">
                    <Label Name="QuoteSenderLabel"/>
                    <RichTextLabel Name="QuoteLabel" MaxWidth="260"/>
                </BoxContainer>
            </PanelContainer>
            <RichTextLabel Name="MessageLabel" Access="Public" HorizontalAlignment="Left" MaxWidth="280"/>
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="ReplyButton" Visible="False" Text="{Loc 'messenger-ui-reply-button'}" StyleClasses="ButtonSmall"/>
                <Label Name="TimeLabel" Access="Public" Margin="6 0 0 0" VerticalAlignment="Center"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</messenger:MessengerUiMessageItem>
