<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Content.Client.UserInterface.Controls"
    x:Class="Content.Client.SS220.Administration.UI.ManageDelivery.DeliveryContentsWindow"
    Title="{Loc admin-verbs-delivery-contents-title}"
    MinSize="420 480">
    <BoxContainer Orientation="Vertical" Margin="5">
        <BoxContainer Orientation="Horizontal">
            <LineEdit
                Name="SearchEdit"
                HorizontalExpand="True"
                PlaceHolder="{Loc admin-verbs-delivery-contents-search}"/>
            <Button
                Name="SearchClearButton"
                Disabled="True"
                Text="{Loc admin-verbs-delivery-contents-clear-search}"/>
        </BoxContainer>

        <PanelContainer VerticalExpand="True" MinSize="0 200">
            <controls:SearchListContainer
                Name="ContentsList"
                Group="True"
                Toggle="True"
                MinSize="200 0"/>
        </PanelContainer>

        <Control MinHeight="6"/>

        <Button
            Name="ClearButton"
            Text="{Loc admin-verbs-delivery-contents-clear}"/>
        <Button
            Name="ReplaceButton"
            Disabled="True"
            Margin="0,5,0,0"
            Text="{Loc admin-verbs-delivery-contents-replace}"/>
    </BoxContainer>
</DefaultWindow>

