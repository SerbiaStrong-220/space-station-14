<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client.SS220.Administration.UI.ManageDelivery.ManageDeliveryWindow"
    Title="{Loc admin-verbs-delivery-title}"
    MinSize="420 620">
    <BoxContainer Orientation="Vertical" Margin="5">
        <Label Name="TargetLabel" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Label Text="{Loc admin-verbs-delivery-reward-label}"/>
        <BoxContainer Orientation="Horizontal">
            <SpinBox Name="RewardSpinBox" HorizontalExpand="True"/>
            <Button Name="ApplyRewardButton" Text="{Loc admin-verbs-delivery-reward-apply}" Margin="5,0,0,0"/>
        </BoxContainer>

        <Control MinHeight="10"/>

        <Label Text="{Loc admin-verbs-delivery-timer-label}"/>
        <Label Name="TimerHintLabel" HorizontalAlignment="Center"/>
        <BoxContainer Orientation="Horizontal">
            <SpinBox Name="TimerSpinBox" HorizontalExpand="True"/>
            <Button Name="ApplyTimerButton" Text="{Loc admin-verbs-delivery-timer-apply}" Margin="5,0,0,0"/>
        </BoxContainer>

        <Control MinHeight="10"/>

        <Label Text="{Loc admin-verbs-delivery-contents-label}"/>
        <Label Name="ContentsLabel" HorizontalAlignment="Center"/>
        <Button Name="OpenContentsButton" Text="{Loc admin-verbs-delivery-contents-open}" Margin="0,5,0,0"/>

        <Control MinHeight="10"/>

        <Label Text="{Loc admin-verbs-delivery-recipient-label}"/>
        <Label Name="CurrentRecipientLabel" HorizontalAlignment="Center"/>
        <LineEdit Name="SearchCrew" PlaceHolder="{Loc admin-verbs-traits-search-placeholder}"/>
        <ItemList Name="CrewList" MinHeight="140" VerticalExpand="True" SelectMode="Single"/>
        <Button Name="ApplyRecipientButton" Text="{Loc admin-verbs-delivery-recipient-apply}" Margin="0,5,0,0"/>
    </BoxContainer>
</DefaultWindow>

